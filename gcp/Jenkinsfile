pipeline {

    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
    }

    environment {

        // ==============================
        // Google Cloud
        // The project ID is read from the VM's metadata server in the first stage,
        // so nothing project-specific is hard-coded here.
        // ==============================
        GCP_REGION = 'asia-south1'

        // ==============================
        // Artifact Registry
        // One Docker repository (created by Terraform) holding three images.
        // Full image path: <region>-docker.pkg.dev/<project-id>/<AR_REPO>/<image>:<tag>
        // ==============================
        AR_REPO              = 'flight-reservation-dev'
        RESERVATION_IMAGE_NAME = 'reservation'
        CHECKIN_IMAGE_NAME     = 'checkin'
        FRONTEND_IMAGE_NAME    = 'frontend'

        // ==============================
        // GitHub (GitOps push-back)
        // ==============================
        GIT_BRANCH  = 'main'
        // Repository Jenkins pushes the new image tags back to (owner/repo). Edit this.
        GITHUB_REPO = 'YOUR_GITHUB_USER/flight-reservation-multicloud'

        // ==============================
        // Jenkins SonarQube server name
        // ==============================
        SONARQUBE_ENV = 'Sonarqube'

        // ==============================
        // Docker image tag
        // ==============================
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        // ============================================================
        // 1. VERIFY GCP
        // ============================================================
        stage('Verify GCP') {
            steps {
                script {
                    env.GCP_PROJECT_ID = sh(
                        returnStdout: true,
                        script: "curl -fsS -H 'Metadata-Flavor: Google' http://metadata.google.internal/computeMetadata/v1/project/project-id"
                    ).trim()
                }

                sh '''
                    set -e

                    echo "=========================================="
                    echo "VERIFYING GOOGLE CLOUD"
                    echo "=========================================="

                    case "${GITHUB_REPO}" in
                        *YOUR_GITHUB_USER*)
                            echo "ERROR: edit GITHUB_REPO in gcp/Jenkinsfile (owner/repo that Jenkins pushes GitOps changes to)."
                            exit 1 ;;
                    esac

                    gcloud auth list

                    echo "GCP project : ${GCP_PROJECT_ID}"
                    echo "GCP region  : ${GCP_REGION}"

                    echo ""
                    echo "Checking Artifact Registry repository..."

                    gcloud artifacts repositories describe "${AR_REPO}" \
                        --project "${GCP_PROJECT_ID}" \
                        --location "${GCP_REGION}"

                    echo ""
                    echo "GCP verification successful."
                '''
            }
        }

        // ============================================================
        // 2. BACKEND BUILD
        // ============================================================
        stage('Backend Build') {
            steps {

                dir('FlightReservationApplication') {
                    sh '''
                        set -e

                        echo "=========================================="
                        echo "BUILDING RESERVATION BACKEND"
                        echo "=========================================="

                        mvn -B clean package -DskipTests

                        echo "Reservation backend build successful."
                    '''
                }

                dir('FlightCheckInApplication') {
                    sh '''
                        set -e

                        echo "=========================================="
                        echo "BUILDING CHECK-IN BACKEND"
                        echo "=========================================="

                        mvn -B clean package -DskipTests

                        echo "Check-In backend build successful."
                    '''
                }
            }
        }

        // ============================================================
        // 3. FRONTEND BUILD
        // ============================================================
        stage('Frontend Build') {
            steps {
                dir('frontend') {
                    sh '''
                        set -e

                        echo "=========================================="
                        echo "BUILDING FRONTEND"
                        echo "=========================================="

                        echo "Configuring frontend API URL..."
                        printf "VITE_API_URL=/api\\n" > .env

                        echo "Installing dependencies..."
                        npm ci

                        echo "Creating production build..."
                        npm run build

                        echo "Frontend build successful."
                    '''
                }
            }
        }

        // ============================================================
        // 4. SONARQUBE ANALYSIS
        // ============================================================
        stage('SonarQube Analysis') {
            steps {

                // ------------------------------
                // Reservation Backend
                // ------------------------------
                dir('FlightReservationApplication') {

                    withSonarQubeEnv("${SONARQUBE_ENV}") {

                        withCredentials([
                            string(
                                credentialsId: 'sonarqube-token',
                                variable: 'SONAR_TOKEN'
                            )
                        ]) {

                            sh '''
                                set -e

                                echo "=========================================="
                                echo "SONARQUBE - RESERVATION BACKEND"
                                echo "=========================================="

                                mvn -B sonar:sonar \
                                    -DskipTests \
                                    -Dsonar.token="$SONAR_TOKEN"

                                echo "Reservation SonarQube analysis submitted."
                            '''
                        }
                    }
                }

                // ------------------------------
                // Check-In Backend
                // ------------------------------
                dir('FlightCheckInApplication') {

                    withSonarQubeEnv("${SONARQUBE_ENV}") {

                        withCredentials([
                            string(
                                credentialsId: 'sonarqube-token',
                                variable: 'SONAR_TOKEN'
                            )
                        ]) {

                            sh '''
                                set -e

                                echo "=========================================="
                                echo "SONARQUBE - CHECK-IN BACKEND"
                                echo "=========================================="

                                mvn -B sonar:sonar \
                                    -DskipTests \
                                    -Dsonar.token="$SONAR_TOKEN"

                                echo "Check-In SonarQube analysis submitted."
                            '''
                        }
                    }
                }
            }
        }

        // ============================================================
        // 5. DOCKER BUILD
        // ============================================================
        stage('Docker Build') {
            steps {
                sh '''
                    set -e

                    echo "=========================================="
                    echo "BUILDING DOCKER IMAGES"
                    echo "=========================================="

                    echo "Building Reservation image..."
                    docker build \
                        -t "${RESERVATION_IMAGE_NAME}:${IMAGE_TAG}" \
                        ./FlightReservationApplication

                    echo "Building Check-In image..."
                    docker build \
                        -t "${CHECKIN_IMAGE_NAME}:${IMAGE_TAG}" \
                        ./FlightCheckInApplication

                    echo "Building Frontend image..."
                    docker build \
                        -t "${FRONTEND_IMAGE_NAME}:${IMAGE_TAG}" \
                        ./frontend

                    echo ""
                    echo "Docker images created:"
                    docker images | grep -E \
                        "^(${RESERVATION_IMAGE_NAME}|${CHECKIN_IMAGE_NAME}|${FRONTEND_IMAGE_NAME}) "
                '''
            }
        }

        // ============================================================
        // 6. ARTIFACT REGISTRY LOGIN
        // ============================================================
        stage('Artifact Registry Login') {
            steps {
                sh '''
                    set -e

                    echo "=========================================="
                    echo "LOGGING INTO ARTIFACT REGISTRY"
                    echo "=========================================="

                    AR_HOST="${GCP_REGION}-docker.pkg.dev"

                    # Uses the Jenkins VM's service account - no key file, no stored credential.
                    gcloud auth print-access-token |
                    docker login \
                        --username oauth2accesstoken \
                        --password-stdin "https://${AR_HOST}"

                    echo "Artifact Registry login successful."
                '''
            }
        }

        // ============================================================
        // 7. TAG IMAGES
        // ============================================================
        stage('Tag Images') {
            steps {
                sh '''
                    set -e

                    echo "=========================================="
                    echo "TAGGING IMAGES FOR ARTIFACT REGISTRY"
                    echo "=========================================="

                    AR_PATH="${GCP_REGION}-docker.pkg.dev/${GCP_PROJECT_ID}/${AR_REPO}"

                    docker tag \
                        "${RESERVATION_IMAGE_NAME}:${IMAGE_TAG}" \
                        "${AR_PATH}/${RESERVATION_IMAGE_NAME}:${IMAGE_TAG}"

                    docker tag \
                        "${CHECKIN_IMAGE_NAME}:${IMAGE_TAG}" \
                        "${AR_PATH}/${CHECKIN_IMAGE_NAME}:${IMAGE_TAG}"

                    docker tag \
                        "${FRONTEND_IMAGE_NAME}:${IMAGE_TAG}" \
                        "${AR_PATH}/${FRONTEND_IMAGE_NAME}:${IMAGE_TAG}"

                    echo ""
                    echo "Artifact Registry image tags:"
                    echo "${AR_PATH}/${RESERVATION_IMAGE_NAME}:${IMAGE_TAG}"
                    echo "${AR_PATH}/${CHECKIN_IMAGE_NAME}:${IMAGE_TAG}"
                    echo "${AR_PATH}/${FRONTEND_IMAGE_NAME}:${IMAGE_TAG}"
                '''
            }
        }

        // ============================================================
        // 8. PUSH IMAGES TO ARTIFACT REGISTRY
        // ============================================================
        stage('Push Images to Artifact Registry') {
            steps {
                sh '''
                    set -e

                    echo "=========================================="
                    echo "PUSHING IMAGES TO ARTIFACT REGISTRY"
                    echo "=========================================="

                    AR_PATH="${GCP_REGION}-docker.pkg.dev/${GCP_PROJECT_ID}/${AR_REPO}"

                    echo "Pushing Reservation image..."
                    docker push \
                        "${AR_PATH}/${RESERVATION_IMAGE_NAME}:${IMAGE_TAG}"

                    echo "Pushing Check-In image..."
                    docker push \
                        "${AR_PATH}/${CHECKIN_IMAGE_NAME}:${IMAGE_TAG}"

                    echo "Pushing Frontend image..."
                    docker push \
                        "${AR_PATH}/${FRONTEND_IMAGE_NAME}:${IMAGE_TAG}"

                    echo ""
                    echo "All images pushed successfully."
                '''
            }
        }

        // ============================================================
        // 9. UPDATE GITOPS
        // ============================================================
        stage('Update GitOps') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'github',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_PASSWORD'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "=========================================="
                        echo "UPDATING GITOPS"
                        echo "=========================================="

                        AR_PATH="${GCP_REGION}-docker.pkg.dev/${GCP_PROJECT_ID}/${AR_REPO}"

                        RESERVATION_IMAGE="${AR_PATH}/${RESERVATION_IMAGE_NAME}:${IMAGE_TAG}"
                        CHECKIN_IMAGE="${AR_PATH}/${CHECKIN_IMAGE_NAME}:${IMAGE_TAG}"
                        FRONTEND_IMAGE="${AR_PATH}/${FRONTEND_IMAGE_NAME}:${IMAGE_TAG}"

                        echo "Reservation image:"
                        echo "${RESERVATION_IMAGE}"

                        echo "Check-In image:"
                        echo "${CHECKIN_IMAGE}"

                        echo "Frontend image:"
                        echo "${FRONTEND_IMAGE}"

                        echo ""
                        echo "Updating reservation deployment..."

                        sed -i -E \
                            "s|^([[:space:]]*image:[[:space:]]*).*$|\\1${RESERVATION_IMAGE}|" \
                            gcp/gitops/reservation-deployment.yaml

                        echo "Updating check-in deployment..."

                        sed -i -E \
                            "s|^([[:space:]]*image:[[:space:]]*).*$|\\1${CHECKIN_IMAGE}|" \
                            gcp/gitops/checkin-deployment.yaml

                        echo "Updating frontend deployment..."

                        sed -i -E \
                            "s|^([[:space:]]*image:[[:space:]]*).*$|\\1${FRONTEND_IMAGE}|" \
                            gcp/gitops/frontend-deployment.yaml

                        echo ""
                        echo "Updated GitOps image references:"

                        echo "--- Reservation ---"
                        grep -n "image:" gcp/gitops/reservation-deployment.yaml

                        echo "--- Check-In ---"
                        grep -n "image:" gcp/gitops/checkin-deployment.yaml

                        echo "--- Frontend ---"
                        grep -n "image:" gcp/gitops/frontend-deployment.yaml

                        echo ""
                        echo "Git status:"
                        git status --short

                        git config user.name "$GIT_USERNAME"
                        git config user.email \
                            "$GIT_USERNAME@users.noreply.github.com"

                        git add \
                            gcp/gitops/reservation-deployment.yaml \
                            gcp/gitops/checkin-deployment.yaml \
                            gcp/gitops/frontend-deployment.yaml

                        if git diff --cached --quiet; then

                            echo "No GitOps changes detected."

                        else

                            git commit \
                                -m "Update application images to build ${IMAGE_TAG}"

                            echo ""
                            echo "Pushing GitOps changes to GitHub..."

                            set +x

                            git push \
                                "https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/${GITHUB_REPO}.git" \
                                "HEAD:${GIT_BRANCH}"

                            set -x

                            echo "GitOps update successful."
                        fi
                    '''
                }
            }
        }

        // ============================================================
        // 10. DOCKER CLEANUP
        // ============================================================
        stage('Docker Cleanup') {
            steps {
                sh '''
                    set +e

                    echo "=========================================="
                    echo "DOCKER CLEANUP"
                    echo "=========================================="

                    AR_PATH="${GCP_REGION}-docker.pkg.dev/${GCP_PROJECT_ID}/${AR_REPO}"

                    for NAME in "${RESERVATION_IMAGE_NAME}" "${CHECKIN_IMAGE_NAME}" "${FRONTEND_IMAGE_NAME}"; do
                        docker rmi "${NAME}:${IMAGE_TAG}" 2>/dev/null
                        docker rmi "${AR_PATH}/${NAME}:${IMAGE_TAG}" 2>/dev/null
                    done

                    docker image prune -f

                    echo "Docker cleanup completed."
                '''
            }
        }
    }

    // ================================================================
    // POST ACTIONS
    // ================================================================
    post {

        success {
            echo '''
            ==========================================
                 JENKINS PIPELINE SUCCESS
            ==========================================

            Build completed successfully.

            ✓ GCP verified
            ✓ Reservation backend built
            ✓ Check-In backend built
            ✓ Frontend built
            ✓ SonarQube analysis completed
            ✓ Docker images built
            ✓ Docker images pushed to Artifact Registry
            ✓ GitOps manifests updated
            ✓ GitOps changes pushed to GitHub

            Argo CD can now synchronize the
            latest GitOps changes into GKE.

            ==========================================
            '''
        }

        failure {
            echo '''
            ==========================================
                  JENKINS PIPELINE FAILED
            ==========================================

            Check the failed stage and Jenkins
            console output for the exact error.

            ==========================================
            '''
        }

        always {
            echo "Pipeline completed: ${BUILD_NUMBER}"
        }
    }
}
